# Slack app credentials (Basic Information → App Credentials)
SLACK_SIGNING_SECRET=
# OAuth & Permissions → Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=

# E2B — https://e2b.dev/dashboard
E2B_API_KEY=

# Claude Code auth. Generate with `claude setup-token` (needs a Pro/Max/Team/
# Enterprise plan). Valid one year. Runs bill against the subscription, not
# API credit — which is the whole point of using this instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional — sandbox template name (defaults to claude-code)
E2B_TEMPLATE=claude-code
# Optional — how long a single Claude run may take, ms (defaults to 10 minutes)
CLAUDE_TIMEOUT_MS=600000
