{
  "display_information": {
    "name": "Joestar",
    "description": "Tag me and I'll reply in the thread with a random number.",
    "background_color": "#4a154b"
  },
  "features": {
    "bot_user": {
      "display_name": "Joestar",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://slack-bot-phi.vercel.app/api/slack/events",
      "bot_events": [
        "app_mention"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
